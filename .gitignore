# Local generated video outputs
*.mp4
*.mov
*.mkv
*.avi
*.webm

# Local render/export work folders
LOCAL_OUTPUTS/*
RENDERS/*
EXPORTS/*
VIDEOS/*

# Keep folder documentation tracked
!LOCAL_OUTPUTS/README.md
!RENDERS/README.md
!EXPORTS/README.md
!VIDEOS/README.md

# Auto-post runtime state and secrets
.env
.env.*
!.env.example
Access_Key.txt
automation/state/*.json
automation/state/*.lock
automation/state/flow-chrome-profile/
automation/logs/
!automation/state/.gitkeep

# Python local cache
__pycache__/
*.py[cod]
